rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'] &&
             data.biometricRequired is bool &&
             data.highContrast is bool &&
             data.voiceFeedbackEnabled is bool &&
             (!('e2eeSaltBase64' in data) || (data.e2eeSaltBase64 is string && data.e2eeSaltBase64.size() <= 128)) &&
             (!('e2eeVerifierBase64' in data) || (data.e2eeVerifierBase64 is string && data.e2eeVerifierBase64.size() <= 256)) &&
             data.dashboardWidgets is list &&
             data.dashboardWidgets.size() <= 10 &&
             (data.dashboardWidgets.size() == 0 || data.dashboardWidgets[0] is string) &&
             data.alertCorridors is list &&
             data.alertCorridors.size() <= 15 &&
             (data.alertCorridors.size() == 0 || data.alertCorridors[0] is string) &&
             (!('lastBackupAtMillis' in data) || (data.lastBackupAtMillis is int && data.lastBackupAtMillis >= 0));
    }

    function isValidRoute(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayLabel is string &&
             data.displayLabel.size() >= 1 &&
             data.displayLabel.size() <= 60 &&
             data.corridorTag is string &&
             data.corridorTag.size() <= 40 &&
             data.mode in ['TRANSIT', 'RAIL', 'BIKE', 'DRIVE', 'WALK'] &&
             data.durationMinutes is int &&
             data.durationMinutes >= 1 &&
             data.durationMinutes <= 1440 &&
             data.distanceKm is number &&
             data.distanceKm >= 0.1 &&
             data.distanceKm <= 5000.0 &&
             data.offlinePinned is bool &&
             data.encryptedPayload is string &&
             data.encryptedPayload.size() >= 1 &&
             data.encryptedPayload.size() <= 8192 &&
             data.payloadIv is string &&
             data.payloadIv.size() >= 1 &&
             data.payloadIv.size() <= 128 &&
             data.keyVersion is int &&
             data.keyVersion >= 1 &&
             data.keyVersion <= 100;
    }

    function isValidAlert(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.category in ['TRANSIT', 'ACCOUNT', 'SECURITY', 'SYNC'] &&
             data.severity in ['INFO', 'ADVISORY', 'CRITICAL'] &&
             data.corridor is string &&
             data.corridor.size() >= 1 &&
             data.corridor.size() <= 60 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 100 &&
             data.encryptedDetails is string &&
             data.encryptedDetails.size() >= 1 &&
             data.encryptedDetails.size() <= 4096 &&
             data.detailsIv is string &&
             data.detailsIv.size() >= 1 &&
             data.detailsIv.size() <= 128 &&
             data.acknowledged is bool;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'themeMode', 'biometricRequired',
                         'highContrast', 'voiceFeedbackEnabled', 'dashboardWidgets',
                         'alertCorridors', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'themeMode', 'biometricRequired',
                         'highContrast', 'voiceFeedbackEnabled', 'e2eeSaltBase64',
                         'e2eeVerifierBase64', 'dashboardWidgets', 'alertCorridors',
                         'lastBackupAtMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'themeMode', 'biometricRequired',
                           'highContrast', 'voiceFeedbackEnabled', 'dashboardWidgets',
                           'alertCorridors', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'e2eeSaltBase64', 'e2eeVerifierBase64', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'lastBackupAtMillis', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /routes/{routeId} {
        allow get: if isOwner(userId) && isValidId(routeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(routeId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'displayLabel', 'corridorTag', 'mode',
                           'durationMinutes', 'distanceKm', 'offlinePinned',
                           'encryptedPayload', 'payloadIv', 'keyVersion',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'displayLabel', 'corridorTag', 'mode',
                           'durationMinutes', 'distanceKm', 'offlinePinned',
                           'encryptedPayload', 'payloadIv', 'keyVersion',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidRoute(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(routeId) &&
                         isValidRoute(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'offlinePinned', 'updatedAt'
                           ]) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayLabel', 'corridorTag', 'mode', 'durationMinutes',
                             'distanceKm', 'offlinePinned', 'encryptedPayload',
                             'payloadIv', 'keyVersion', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(routeId);
      }

      match /alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(alertId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(alertId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'category', 'severity', 'corridor',
                           'title', 'encryptedDetails', 'detailsIv',
                           'acknowledged', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'category', 'severity', 'corridor',
                           'title', 'encryptedDetails', 'detailsIv',
                           'acknowledged', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidAlert(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(alertId) &&
                         isValidAlert(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'acknowledged', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(alertId);
      }
    }
  }
}
